<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Serve solo per proporti le challenge della tua zona. Salviamo una zona approssimata, mai la posizione esatta.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Serve per scegliere dalla galleria la foto con cui partecipi a una challenge, o la tua foto profilo.</string>
	<!-- **Senza questa riga l'app si chiude di colpo** nel momento in cui
	     qualcuno prova a registrare un video: iOS non chiede il permesso, non
	     mostra un errore, termina il processo. Ed e' il tipo di guasto che
	     sembra un difetto dell'app e invece e' una riga di configurazione
	     mancante. Il microfono serve perche' un video ha l'audio: senza, non e'
	     un video, e' una sequenza di immagini. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Serve il microfono per registrare l'audio del video con cui partecipi a una challenge.</string>
	<key>NSCameraUsageDescription</key>
	<string>Serve la fotocamera per scattare al volo la foto con cui partecipi a una challenge.</string>
	<!-- **Lo schema con cui Firebase rientra nell'app.**

	     Serve alla verifica del numero di telefono. Su iPhone Firebase prova
	     prima una notifica silenziosa; se quella non passa — succede sui
	     simulatori, con certe reti, e la prima volta dopo l'installazione —
	     ripiega su un controllo anti-robot che apre una pagina web, e da quella
	     pagina deve poter tornare dentro l'app.

	     Senza questa riga non torna: **l'app si chiude di colpo** nel momento in
	     cui si tocca "mandami il codice". Non e' un errore che si vede scrivendo
	     il codice, perche' il codice e' giusto: manca un pezzo di configurazione
	     che vive qui dentro.

	     Il valore e' l'identificativo dell'app su Firebase con i due punti
	     trasformati in trattini. Non e' un segreto: sta gia' dentro l'app. -->
	<!-- **Le notifiche silenziose.**

	     Servono a due cose diverse che senza questa riga funzionano tutte e due a
	     meta'. La prima e' la verifica del numero di telefono: Firebase prova a
	     confermare l'app mandandole una notifica che non si vede, e solo se
	     fallisce ripiega sul controllo anti-robot con la pagina web. La seconda e'
	     la consegna in secondo piano, che permette all'app di prepararsi prima che
	     la notifica compaia sullo schermo bloccato. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-1-781052311292-ios-cf2f5293adc52143264979</string>
			</array>
		</dict>
		<!-- **Il nome con cui l'app si fa chiamare da fuori.**

		     Serve a chi finisce sul sito partendo dall'app: dopo aver rifatto
		     la password, la pagina di conferma puo' dire al telefono "riapri
		     CRASY" invece di lasciare qualcuno dentro un browser, sul sito,
		     davanti a un bottone che lo rimanda al punto di partenza.

		     `crasy` e non un indirizzo vero: i collegamenti universali —
		     quelli che aprono l'app toccando un link a crasyapp.com — vogliono
		     il dominio collegato a Hosting e un file di associazione firmato,
		     e finche' non c'e' quello questo e' l'unico modo per riaprire
		     l'app dal browser. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.crasy.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>crasy</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- Nessuna crittografia da dichiarare.
	     Senza questa riga App Store Connect chiede la conformita' all'export
	     a **ogni singolo caricamento**, e finche' non si risponde la build non
	     arriva ai tester: si carica, si aspetta, e non succede niente. CRASY usa
	     solo HTTPS, che rientra fra le esenzioni. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDisplayName</key>
	<string>CRASY</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>crasy</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Senza questo un link universale entra nell'app ma non arriva al
	     router: Flutter lo lascia cadere e si atterra sulla home, come se
	     l'app si fosse aperta da sola. E' la meta' iPhone della stessa riga
	     che sta nel manifesto di Android. -->
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>

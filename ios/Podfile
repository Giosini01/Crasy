# **Il Podfile sta nel progetto, non lo genera la macchina che compila.**
#
# Non c'era: Flutter lo crea da un modello quando manca, e per mesi e' andato
# bene perche' nessuna libreria chiedeva niente di particolare. Il foglio di
# pagamento di Stripe invece pretende iOS 13 come minimo, e il modello lascia
# quella riga commentata — cioe' decide CocoaPods, cioe' dipende dalla versione
# di Flutter installata su una macchina che non e' questa. Un pacchetto che non
# compila sul server di build e compila qui e' la peggior specie di guasto.
#
# Quindici, non tredici: e' gia' il minimo del progetto Xcode, e tenere i due
# numeri allineati evita l'avviso che CocoaPods stampa a ogni installazione.
platform :ios, '15.0'

# CocoaPods analizza il progetto a ogni comando, e su un progetto Flutter sono
# svariati secondi buttati ogni volta.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)

  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end

  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Le dipendenze seguono il minimo del progetto invece di portarsi dietro
      # il loro: senza questa riga qualche pacchetto si ferma a iOS 12 e Xcode
      # riempie la build di avvisi che nascondono quelli veri.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end

{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "daily-dating-app",
          "appId": "1:781052311292:android:3cc1796f149d9b04264979",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "daily-dating-app",
          "configurations": {
            "android": "1:781052311292:android:3cc1796f149d9b04264979",
            "ios": "1:781052311292:ios:6fdfb01344985a3c264979",
            "web": "1:781052311292:web:4e9ed36cc12836f6264979"
          }
        }
      }
    }
  },
  "hosting": {
    "site": "crasy",
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, max-age=0" }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, max-age=0" }
        ]
      },
      {
        "source": "/version.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, max-age=0" }
        ]
      },
      {
        "source": "**/*.@(js|wasm|png|jpg|jpeg|svg|ttf|otf|json)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}

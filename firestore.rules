rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Vero se la scrittura tocca **solo** i campi elencati.
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Le parole che non si possono scrivere in una challenge.
    //
    // E' un ultimo sbarramento, non il controllo vero: quello sta nell'app
    // (`lib/core/moderation/content_policy.dart`), che sa leggere anche i
    // travestimenti — i numeri al posto delle lettere, le lettere spaziate —
    // e che spiega alla persona **perche'**, offrendo un numero da chiamare nel
    // caso piu' delicato.
    //
    // Qui si prendono i casi espliciti, e si prendono **anche se qualcuno
    // scrivesse sul database saltando l'app**. Con dei soldi in palio,
    // "tagliati le vene" non e' un contenuto discutibile: e' un incarico
    // retribuito a farsi del male.
    //
    // Sono quattro espressioni e non una: le regole di Firestore hanno un
    // limite di lunghezza sulle espressioni regolari, e una sola lunga il
    // triplo smetterebbe di compilare senza dire chiaramente perche'.
    function saysSomethingForbidden(text) {
      return text.lower().matches(
        '.*(suicid|ammazzat|uccidit|uccidet|uccidersi|tagliati le vene|tagliarsi le vene|tagliati i polsi|fine alla tua vita|farla finita|togliti la vita|impiccat|autolesion|fatti del male|farti del male|ferisciti|buttati di sotto|salta dal balcone|salta dalla finestra|overdose|candeggina|kill yourself|self harm|cut yourself).*'
      ) || text.lower().matches(
        '.*(picchia|accoltell|aggredisci|torturar|sfregia|maltratta|seviz|stupr|violenta qualcuno|dai fuoco a|molesta|beat someone|stab someone|shoot someone).*'
      ) || text.lower().matches(
        '.*(nud|spogliat|spogliar|senza vestiti|senza mutande|in mutande|reggiseno|perizoma|topless|genital|porno|masturb|sessual|erotic|luci rosse|onlyfans|escort|prostitu|orgasm|sexy|naked|nsfw|striptease).*'
      ) || text.lower().matches(
        '.*(guida ubriac|guidare ubriac|contromano|attraversa i binari|sui binari|cornicion|tetto del treno|benzina addosso|soffocamento|pedofil|spaccia|cocain|eroina|taccheggio).*'
      );
    }

    // Le partecipazioni lette **attraverso tutte le challenge insieme**.
    //
    // Serve una regola a se', e non e' un doppione di quella annidata piu'
    // sotto: una query su un gruppo di collezioni non viene autorizzata dalle
    // regole scritte su un percorso annidato. Firestore la valuta contro un
    // `match` che comincia con il jolly, e se non lo trova rifiuta.
    //
    // Senza questa riga il feed, "le tue in gara" e la griglia del profilo —
    // che sono tutti query sul gruppo — tornavano vuoti, mentre le stesse foto
    // dentro la loro challenge si vedevano benissimo. Nessun errore a schermo:
    // solo sezioni vuote.
    match /{path=**}/entries/{entryId} {
      allow read: if signedIn();
    }

    // **Le segnalazioni: si scrivono e basta.**
    //
    // Chi ha fatto l'accesso puo' segnalare, e puo' segnalare **solo a nome
    // proprio**. Nessuno le puo' rileggere, nemmeno chi le ha scritte: una
    // segnalazione contiene il nome di chi ha segnalato, e in un'app dove le
    // persone si conoscono fra loro, poter scoprire chi ti ha segnalato
    // trasformerebbe la moderazione in una resa dei conti. Le leggiamo noi con
    // l'SDK di amministrazione, che da qui non passa.
    //
    // L'identificativo del documento mette insieme chi segnala e cosa: la
    // stessa persona non puo' far salire il conto da sola segnalando dieci
    // volte, perche' riscriverebbe sempre lo stesso documento.
    match /reports/{reportId} {
      allow read: if false;
      allow create: if signedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && reportId == request.auth.uid + '__'
                       + request.resource.data.kind
                       + (request.resource.data.challengeId == '' ? ''
                          : '__' + request.resource.data.challengeId)
                       + (request.resource.data.entryId == '' ? ''
                          : '__' + request.resource.data.entryId)
                       + (request.resource.data.commentId == '' ? ''
                          : '__' + request.resource.data.commentId)
                       + ((request.resource.data.entryId == ''
                           && request.resource.data.commentId == '') ? '__'
                          + request.resource.data.reportedUserId : '')
                    && request.resource.data.reportedUserId != request.auth.uid;

      // **Una segnalazione non si ritira e non si cambia.** Se si potesse,
      // basterebbe una minaccia — "ritira quella segnalazione" — perche' venga
      // ritirata.
      allow update, delete: if false;
    }

    // **La sfida del giorno: si legge, non si scrive.**
    //
    // Un documento per giorno — `2026-08-30` — con dentro l'identificativo
    // della gara messa in cima per quel giorno. Nessun utente lo puo' scrivere,
    // nemmeno il proprietario della gara che ci finisce dentro: se lo potesse
    // fare, la prima cosa che succederebbe e' che tutti si metterebbero la
    // propria in cima.
    match /daily/{giorno} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Il profilo.
    //
    // **Lo legge chiunque abbia fatto l'accesso, lo scrive solo il diretto
    // interessato.** I profili sono pubblici da quando esistono gli amici: si
    // arriva a una persona dalla foto che ha mandato, e li' si vede cosa ha
    // fatto — scatti, vittorie, premi, amici.
    //
    // Va detto cosa questo comporta: nel documento c'e' anche la data di
    // nascita, e chi legge il database direttamente puo' vederla. E' il prezzo
    // di tenere il profilo in un documento solo; il giorno in cui pesera'
    // davvero, la data va spostata in un documento privato accanto a questo,
    // non nascosta con una regola — **le regole non filtrano i campi, filtrano
    // i documenti**.
    match /users/{userId} {
      // **Su CRASY si entra da maggiorenni.**
      //
      // Il conto in giorni e' un'approssimazione — le regole di Firestore non
      // sanno fare i conti sui calendari — ed e' voluta: qui si vuole solo
      // impedire che un profilo dichiaratamente minorenne finisca nel database.
      // Il controllo preciso, con i compleanni al posto giusto, lo fa l'app.
      //
      // E va detto cosa questo **non** e': una data che uno si scrive da solo
      // non e' una verifica dell'eta'. Ferma chi e' onesto, non chi mente.
      function isAdultProfile() {
        return request.resource.data.birthDate is timestamp
               && request.resource.data.birthDate
                  < request.time - duration.value(6570, 'd');
      }

      // **Il saldo del portafoglio non lo tocca nessun telefono.**
      //
      // E' la riga piu' importante di questo file dopo quella sul premio: se
      // `walletCents` fosse scrivibile dal client, regalarsi mille euro
      // sarebbe cambiare un numero. A muoverlo e' solo il server — accredita
      // quando una gara si chiude, azzera quando qualcuno preleva — e il server
      // scrive con l'SDK di amministrazione, che queste regole non le
      // attraversa nemmeno.
      //
      // Alla creazione il saldo non c'e' proprio: nasce quando arriva il primo
      // premio.
      function doesNotTouchTheWallet() {
        return !('walletCents' in request.resource.data.diff(resource.data).affectedKeys())
               && !('withdrawingCents' in request.resource.data.diff(resource.data).affectedKeys())
               && !('stripeAccountId' in request.resource.data.diff(resource.data).affectedKeys())
               && !('payoutReady' in request.resource.data.diff(resource.data).affectedKeys());
      }

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && isAdultProfile()
                    && !('walletCents' in request.resource.data);

      allow update: if signedIn()
                    && request.auth.uid == userId
                    && isAdultProfile()
                    && doesNotTouchTheWallet();
      allow read: if signedIn();

      // **Il proprio profilo si cancella, ma non con dei soldi dentro.**
      //
      // Cancellare l'account e' un diritto — il GDPR lo chiama diritto
      // all'oblio, e Apple non pubblica un'app che non lo offre. Ma un profilo
      // che sparisce con un saldo diverso da zero porta via le tracce di soldi
      // veri: quelli vanno prelevati prima, e finche' ci sono questa riga
      // tiene il documento dov'e'.
      //
      // Si legge con `get` perche' il saldo nasce solo con il primo premio: un
      // profilo che non ha mai vinto niente quel campo non ce l'ha, e
      // pretenderlo lo renderebbe incancellabile.
      allow delete: if signedIn()
                    && request.auth.uid == userId
                    && resource.data.get('walletCents', 0) == 0
                    && resource.data.get('withdrawingCents', 0) == 0;

      // **Il registro dei consensi. Si scrive e non si tocca piu'.**
      //
      // Il GDPR non chiede solo di raccogliere il consenso: chiede di poter
      // dimostrare chi ha acconsentito, a che cosa e quando. Una riga che si
      // puo' modificare non dimostra niente, e una che si puo' cancellare
      // dimostra ancora meno — quindi qui non si aggiorna e non si cancella,
      // nemmeno il proprietario.
      //
      // Revocare un consenso non cancella niente: aggiunge una riga nuova che
      // dice "da adesso no". La storia resta leggibile in tutte e due le
      // direzioni.
      //
      // La legge solo chi la riguarda: sono le sue scelte, non un dato
      // pubblico come il nome utente.
      match /consents/{consentId} {
        allow read, create: if signedIn() && request.auth.uid == userId;
        allow update, delete: if false;
      }

      // Cosa ho votato.
      //
      // Sta sotto chi ha votato e non sotto la foto votata: cosi' "ho gia'
      // votato questa?" e' una lettura della propria sottocollezione, e nessuno
      // puo' sapere chi ha votato cosa.
      match /votes/{entryId} {
        allow read, create, delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }

      // La campanella.
      //
      // **Le scrive chi le provoca**, dentro le notifiche di chi le riceve. E'
      // il rovescio di come dovrebbe funzionare, e c'e' una ragione: senza un
      // server acceso — le Cloud Function richiedono il piano a pagamento —
      // nessun altro puo' accorgersi che qualcuno ha dato una fiamma. Chi la
      // da' e' l'unico che lo sa nel momento in cui succede.
      //
      // Quello che si puo' difendere qui, si difende: si scrive solo
      // dichiarando **il proprio** identificativo come autore, non si scrive a
      // se' stessi, e **non si tocca una notifica gia' scritta**. Quest'ultima
      // e' la piu' importante: insieme al nome del documento — che per una
      // fiamma e' sempre `fiamma_{foto}_{chiVota}` — rende impossibile mandare
      // la stessa notifica due volte. Chi toglie e rimette una fiamma venti
      // volte trova venti rifiuti, e chi la riceve una riga sola.
      //
      // Resta possibile scrivere una notifica per una fiamma mai data. E' una
      // bugia che costa una riga in una campanella e non sposta ne' voti ne'
      // soldi: il conto delle fiamme sta altrove, ed e' quello a decidere chi
      // vince.
      // Il portafoglio, riga per riga.
      //
      // Si legge e basta, e lo legge solo il diretto interessato: da dove
      // vengono i soldi di una persona non e' affare di nessun altro.
      match /wallet/{movementId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;

        allow create: if signedIn()
                      && request.resource.data.actorId == request.auth.uid
                      && request.auth.uid != userId
                      // `mention` sta qui insieme alle altre due perche' e'
                      // scritta dallo stesso posto: chi commenta nominando
                      // qualcuno gli scrive la notizia nella campanella. Le
                      // altre — vittorie, amicizie, gare finite — non le scrive
                      // nessuno: si ricavano dai dati che esistono gia'.
                      && request.resource.data.kind
                         in ['participation', 'fire', 'mention', 'comment']
                      && request.resource.data.actorUsername is string;

        allow update: if false;
      }

      // Le richieste di amicizia **ricevute**.
      //
      // Stanno sotto chi le riceve, con l'identificativo di chi le manda come
      // nome del documento: due volte la stessa richiesta e' due volte lo
      // stesso documento, quindi non esiste il caso di venti richieste dalla
      // stessa persona.
      //
      // Le legge chi le riceve, e le rilegge chi le ha mandate: quel secondo
      // permesso e' quello che fa scrivere "richiesta mandata" sul bottone
      // invece di riproporre "aggiungi" all'infinito.
      match /friendRequests/{fromUserId} {
        allow read: if signedIn()
                    && (request.auth.uid == userId
                        || request.auth.uid == fromUserId);

        allow create: if signedIn()
                      && request.auth.uid == fromUserId
                      && fromUserId != userId
                      && request.resource.data.fromUsername is string;

        // La cancella chi l'ha mandata (ci ha ripensato) e chi l'ha ricevuta
        // (accetta o rifiuta). Sono gli stessi due permessi visti da due parti.
        allow delete: if signedIn()
                      && (request.auth.uid == userId
                          || request.auth.uid == fromUserId);

        allow update: if false;
      }

      // Gli amici.
      //
      // Un'amicizia sono due documenti, uno per parte, e nascono insieme quando
      // si accetta una richiesta. **Ognuno dei due deve poter scrivere nella
      // cartella dell'altro**, altrimenti l'amicizia resterebbe scritta da un
      // lato solo: per questo la condizione non e' "e' casa mia", ma "esiste la
      // richiesta che la giustifica".
      //
      // E' quella richiesta a rendere impossibile aggiungersi da soli fra gli
      // amici di qualcuno: senza un documento che quella persona ha ricevuto,
      // nessuna delle due righe si puo' scrivere.
      // **I telefoni a cui mandare le notifiche.**
      //
      // Li scrive e li legge soltanto il diretto interessato. Nessun altro:
      // l'indirizzo di un dispositivo e' cio' che serve per mandargli una
      // notifica, e lasciarlo leggere a chiunque vorrebbe dire consegnare a
      // chiunque il modo di far vibrare il telefono di un altro.
      //
      // Il nome del documento e' l'indirizzo stesso: riscriverlo non crea
      // doppioni, e due notifiche identiche sullo stesso telefono sono il modo
      // piu' veloce per farsele disattivare.
      match /devices/{token} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // **Chi ho bloccato: lo leggo e lo scrivo solo io.**
      //
      // Nessun altro, e in particolare **non chi e' stato bloccato**: sapere
      // di essere stati bloccati e' l'informazione che trasforma un blocco in
      // una lite. Chi blocca deve poter sparire in silenzio.
      match /blocked/{otherId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /friends/{friendId} {
        function pendingRequest(to, from) {
          return exists(
            /databases/$(database)/documents/users/$(to)/friendRequests/$(from)
          );
        }

        // Quanti amici ha una persona e' un numero pubblico: sta scritto sul
        // suo profilo, che chiunque puo' aprire.
        allow read: if signedIn();

        allow create: if signedIn()
                      && ((request.auth.uid == userId
                           && pendingRequest(userId, friendId))
                          || (request.auth.uid == friendId
                              && pendingRequest(friendId, userId)));

        // Toglie l'amicizia chi dei due vuole: sparisce da tutte e due le
        // parti, perche' un'amicizia a senso unico non esiste.
        allow delete: if signedIn()
                      && (request.auth.uid == userId
                          || request.auth.uid == friendId);

        allow update: if false;
      }
    }

    match /challenges/{challengeId} {

      function challenge() {
        return get(/databases/$(database)/documents/challenges/$(challengeId)).data;
      }

      function challengeIsLive() {
        return challenge().startsAt <= request.time
               && challenge().endsAt > request.time;
      }

      // **Niente si legge senza aver fatto l'accesso, e le gare riservate solo
      // se sei fra i destinatari.**
      //
      // L'app impedisce gia' da sola di vedere quello che non ti riguarda, ma
      // se qui restasse aperto il muro esisterebbe solo nell'interfaccia:
      // chiunque potrebbe leggere tutto chiamando il database direttamente. Una
      // gara "solo per amici" che si legge scrivendo un indirizzo non e' una
      // gara solo per amici — e' una promessa.
      //
      // Chi la puo' vedere sta **dentro la gara**, in `audience`: `*` per le
      // pubbliche, l'elenco dei destinatari per le riservate. E' scritto li' e
      // non ricavato leggendo l'elenco degli amici perche' una regola che va a
      // leggere un altro documento **paga una lettura per ogni gara di ogni
      // schermata**, e oltre una certa quantita' Firestore si rifiuta proprio.
      //
      // Le due liste — home e vincitori — chiedono esplicitamente `audience`
      // contiene `*`; la scheda degli amici chiede `audience` contiene il
      // proprio identificativo. Cosi' nessuna query prova a leggere qualcosa
      // che questa regola poi rifiuta: se lo facesse, non tornerebbe una lista
      // filtrata — fallirebbe tutta.
      //
      // Il valore di ripiego e' `['*']`: una gara scritta prima che questo
      // campo esistesse resta pubblica, come e' sempre stata.
      allow read: if signedIn()
                  && (
                       // **Un documento che non esiste si puo' leggere.**
                       //
                       // Sembra strano detto cosi', e invece e' la riga che
                       // ripara un guasto vero: chiedendo una gara cancellata —
                       // da una notifica vecchia, da un trofeo, da un
                       // collegamento condiviso — `resource` e' nullo, e
                       // chiedergli `audience` faceva fallire la regola. Il
                       // risultato non era "questa gara non c'e' piu'": era
                       // **"non riusciamo a caricarla, riprova"**, cioe' un
                       // errore di rete per una cosa che non e' un errore.
                       //
                       // Senza documento non c'e' niente da proteggere: si
                       // lascia passare, e l'app trova il vuoto che si aspetta.
                       resource == null
                       || '*' in resource.data.get('audience', ['*'])
                       || request.auth.uid in resource.data.get('audience', ['*'])
                     );

      // Una challenge la lancia chiunque abbia un account.
      //
      // **Chi la lancia paga il premio, e CRASY non fa da garante.** E' una
      // scelta di prodotto, non una svista di sicurezza: qui si controlla che
      // il documento sia ben formato, non che dietro ci siano davvero i soldi.
      // Nessuna regola di database puo' controllare quello.
      //
      // I controlli servono a impedire le cose che il database *puo'* sapere:
      // che nessuno si spacci per un altro, che una challenge non nasca gia'
      // scaduta, che non nasca con dei partecipanti o con un vincitore gia'
      // scritto.
      allow create: if signedIn()
                    && request.resource.data.createdByUserId == request.auth.uid
                    && request.resource.data.createdByUsername is string
                    && request.resource.data.title is string
                    && !saysSomethingForbidden(request.resource.data.title)
                    && !saysSomethingForbidden(request.resource.data.brief)
                    && request.resource.data.title.size() >= 3
                    && request.resource.data.title.size() <= 60
                    && request.resource.data.brief is string
                    && request.resource.data.brief.size() > 0
                    && request.resource.data.brief.size() <= 280
                    && request.resource.data.place is string
                    // **`friends` va nell'elenco, o la gara fra amici non
                    // nasce.** L'ambito nuovo era stato aggiunto nell'app e non
                    // qui, e il risultato era un "operazione non consentita"
                    // secco al momento di lanciarla: l'app diceva di si', il
                    // database di no.
                    //
                    // Vale la pena tenerlo un elenco chiuso invece di accettare
                    // qualunque parola: uno scope inventato non lo capirebbe
                    // nessuna schermata, e la gara resterebbe invisibile senza
                    // che nessuno sappia perche'.
                    && request.resource.data.scope in
                       ['global', 'country', 'local', 'friends', 'private']
                    && request.resource.data.rules is list
                    // Foto o video: il vincolo lo sceglie chi lancia. Si legge
                    // con `get` perche' le challenge nate prima che il vincolo
                    // esistesse sono tutte di foto, e devono restare valide.
                    && request.resource.data.get('mediaKind', 'photo')
                       in ['photo', 'video']
                    && request.resource.data.prizeCents is int
                    // Almeno un euro, come nell'app. Un centesimo non e' un
                    // premio: occuperebbe in home lo stesso spazio di una gara
                    // vera e si mangerebbe una delle cinque partecipazioni di
                    // chi ci casca. La soglia sta anche qui perche' l'app si
                    // puo' saltare, il database no.
                    // **Chi la puo' vedere dev'essere scritto bene.**
                    //
                    // Senza questa riga il minimo di un euro si aggira in un
                    // modo solo: si scrive `scope: friends` per avere il premio
                    // a zero e poi si mette `*` fra i destinatari, ottenendo una
                    // gara pubblica gratis. Una gara riservata **non puo'**
                    // essere aperta a tutti, e chi la lancia dev'esserci dentro.
                    && request.resource.data.audience is list
                    && request.resource.data.audience.size() > 0
                    && request.resource.data.audience.size() <= 300
                    && (
                         request.resource.data.get('scope', '') != 'friends'
                           ? '*' in request.resource.data.audience
                           : (
                               !('*' in request.resource.data.audience)
                               && request.auth.uid in request.resource.data.audience
                             )
                       )
                    // **Un euro di minimo, tranne fra amici.**
                    //
                    // Sotto un euro un premio smette di essere un premio. Ma
                    // una gara riservata agli amici puo' valere zero: li' la
                    // sfida vale gia' per conto suo, e chiedere un euro per
                    // lanciarla metterebbe un casello davanti alla cosa piu'
                    // naturale che si fa qui dentro.
                    && (
                         request.resource.data.prizeCents >= 100
                         || (
                              request.resource.data.get('scope', '') == 'friends'
                              && request.resource.data.prizeCents == 0
                            )
                       )
                    && request.resource.data.prizeCents <= 100000000
                    // Nasce vuota e senza vincitore: i partecipanti li porta
                    // il tempo, il vincitore lo proclama il server.
                    && request.resource.data.participantsCount == 0
                    && request.resource.data.winnerEntryId == null
                    // **E nasce non pagata.**
                    //
                    // E' la riga che regge l'intero impianto dei soldi. Il
                    // premio diventa `held` solo quando Stripe conferma
                    // l'incasso, e quella conferma arriva a una funzione sul
                    // server che scrive con l'SDK di amministrazione — che
                    // queste regole non le attraversa nemmeno.
                    //
                    // Senza questa riga, pubblicare una challenge da mille euro
                    // senza tirare fuori un centesimo sarebbe una parola
                    // cambiata in una scrittura sul database. Con questa riga,
                    // e' impossibile: non esiste nessun percorso che porti un
                    // telefono a scrivere `held`.
                    && request.resource.data.get('prizeStatus', 'unpaid')
                       == 'unpaid'
                    && request.resource.data.startsAt is timestamp
                    && request.resource.data.endsAt is timestamp
                    && request.resource.data.endsAt > request.resource.data.startsAt
                    && request.resource.data.endsAt > request.time;

      // **Si cancella finche' e' vuota, e solo da chi l'ha lanciata.**
      //
      // Il divieto di prima era assoluto — "c'e' gente che ci ha gia' mandato le
      // proprie foto" — e valeva per la ragione giusta applicata a un caso solo.
      // Se nessuno ha ancora partecipato non c'e' nessuna foto da difendere:
      // c'e' una gara scritta male, con il premio sbagliato o il titolo storto,
      // che chi l'ha lanciata guarda senza poterci fare niente. Restava li' fino
      // alla scadenza, occupando la home.
      //
      // Le tre condizioni non sono facoltative. **Zero partecipanti**, perche'
      // dalla prima foto in poi la gara non e' piu' solo di chi l'ha lanciata.
      // **Premio non incassato**, perche' cancellare una gara con dei soldi in
      // cassa vorrebbe dire perderne le tracce. E **solo il proprietario**, che
      // e' ovvio e va scritto lo stesso.
      allow delete: if signedIn()
                    && resource.data.createdByUserId == request.auth.uid
                    && resource.data.get('participantsCount', 0) == 0
                    && resource.data.get('prizeStatus', 'unpaid') == 'unpaid';

      // L'unica cosa che il client puo' toccare e' il contatore dei
      // partecipanti, e solo per farlo salire di uno: e' la transazione con cui
      // nasce una partecipazione.
      //
      // In particolare **non puo' toccare `prizeStatus`**, ed e' il `changedOnly`
      // qui sotto a impedirlo: qualunque scrittura che sfiori un secondo campo
      // viene rifiutata, senza bisogno di elencare uno per uno i campi vietati.
      allow update: if signedIn()
                    && changedOnly(['participantsCount'])
                    && request.resource.data.participantsCount
                       == resource.data.participantsCount + 1;

      // **Chiudere una gara scaduta. Strada temporanea, e si spegne da sola.**
      //
      // A proclamare il vincitore dovrebbe essere il server, e il codice c'e'
      // gia': una funzione che gira ogni cinque minuti, e che richiede il piano
      // a pagamento di Firebase. Finche' quel piano non e' attivo **nessuna
      // challenge si chiude**: scadono e restano li' per sempre, e il giro del
      // prodotto non si vede mai finire. Cosi' invece la chiude il primo che la
      // apre dopo la scadenza.
      //
      // Il permesso e' legato a `prizeStatus == 'unpaid'`, ed e' la parte che
      // conta: vale solo dove **CRASY non ha in cassa un centesimo**. Il giorno
      // in cui i pagamenti si accendono, ogni gara visibile e' pagata e da qui
      // non si proclama piu' niente — senza che nessuno debba ricordarsi di
      // cancellare questa regola.
      //
      // Va detto cosa questo permette, oggi: **chiunque puo' scrivere il nome
      // di un vincitore diverso da quello vero**, perche' il conto delle fiamme
      // lo fa chi scrive e nessuna regola puo' rifarlo. Non ci sono soldi di
      // mezzo, e il costo di non chiudere mai una gara e' piu' alto. E' una
      // delle ragioni per cui questa strada deve sparire il giorno in cui il
      // server si accende — cosa che succede da sola.
      //
      // **La foto del trofeo dev'essere quella che ha davvero vinto.**
      //
      // Insieme al vincitore si scrive nella gara una copia della sua foto:
      // serve a farla sopravvivere alla pulizia che quarantotto ore dopo
      // cancella le partecipazioni. Ma una copia e' un dato scritto da un
      // telefono, e senza questo controllo chiunque potrebbe proclamare un
      // vincitore e attaccarci l'immagine che vuole — una figurina falsa nella
      // bacheca di qualcun altro.
      //
      // Si va a leggere la partecipazione dichiarata vincente e si pretende che
      // l'indirizzo combaci. Vale finche' quella partecipazione esiste, cioe'
      // esattamente il momento in cui si proclama.
      //
      // Vincitore vuoto vuol dire "non ha partecipato nessuno": non c'e'
      // nessuna foto da controllare, e la seconda meta' non viene nemmeno
      // valutata.
      function winnerPhotoIsReal() {
        return request.resource.data.winnerEntryId == ''
               || request.resource.data.winnerMediaUrl == get(
                    /databases/$(database)/documents/challenges/$(challengeId)/entries/$(request.resource.data.winnerEntryId)
                  ).data.mediaUrl;
      }

      allow update: if signedIn()
                    && changedOnly([
                         'winnerEntryId', 'winnerUserId',
                         'winnerUsername', 'winnerMediaUrl',
                         'winnerMediaKind', 'winnerVotes'
                       ])
                    && winnerPhotoIsReal()
                    && resource.data.get('prizeStatus', 'unpaid') == 'unpaid'
                    && resource.data.get('winnerEntryId', null) == null
                    && resource.data.endsAt <= request.time;

      match /entries/{entryId} {

        // L'identificativo della partecipazione **e'** l'identificativo di chi
        // l'ha mandata. E' la regola "una foto a testa" scritta nella forma dei
        // dati: con dei soldi in palio, mandarne venti per moltiplicare le
        // proprie probabilita' e' la prima cosa che verrebbe in mente.
        function isAuthor() {
          return signedIn() && request.auth.uid == entryId;
        }

        allow read: if signedIn();

        allow create: if isAuthor()
                      && request.resource.data.userId == request.auth.uid
                      // **I posti sono finiti: non si entra piu'.**
                      //
                      // Il tetto lo sceglie chi lancia la gara, e serve a
                      // tenerla giocabile: con cinquecento foto nessuno le
                      // guarda tutte, si vota fra le prime che capitano, e
                      // vince la posizione nella lista invece di quello che
                      // uno ha fatto.
                      //
                      // Sta qui e non solo nell'interfaccia, o si aggira in
                      // dieci secondi scrivendo sul database. Zero vuol dire
                      // senza limite, ed e' anche cio' che si legge sulle gare
                      // scritte prima che questo campo esistesse.
                      //
                      // **Due persone che mandano nello stesso istante possono
                      // passare tutte e due**, perche' leggono lo stesso conto
                      // prima che l'altra scriva: ogni tanto saranno undici
                      // invece di dieci. Chiuderla davvero vorrebbe dire una
                      // transazione sul server, e a questa scala non vale il
                      // prezzo — undici in gara non rovina niente, mille si'.
                      // Chi ha lanciato la challenge non ci partecipa: mette
                      // lui i soldi del premio, e una gara in cui chi paga
                      // puo' anche vincere non e' una gara.
                      && (
                           challenge().get('maxParticipants', 0) == 0
                           || challenge().get('participantsCount', 0)
                              < challenge().get('maxParticipants', 0)
                         )
                      && challenge().createdByUserId != request.auth.uid
                      && request.resource.data.mediaUrl is string
                      && request.resource.data.mediaUrl.size() > 0
                      // Il vincolo si rispetta: a una challenge di video non si
                      // manda una foto. L'app non lo permette gia' — la
                      // fotocamera si apre nel modo giusto e basta — ma il
                      // vincolo e' meta' della gara, e una gara non si difende
                      // solo nell'interfaccia.
                      && request.resource.data.get('mediaKind', 'photo')
                         == challenge().get('mediaKind', 'photo')
                      // Le fiamme partono da zero.
                      //
                      // Si legge con `get` e non direttamente, e la differenza
                      // e' costata una partecipazione persa: pretendendo il
                      // campo, ogni telefono con una versione dell'app appena
                      // precedente si vedeva **rifiutare la propria foto** con
                      // un "non hai accesso" incomprensibile. Le regole le
                      // aggiorni in un istante, le app installate no: una
                      // condizione che i client vecchi non sanno soddisfare e'
                      // sbagliata anche quando e' piu' pulita.
                      && request.resource.data.get('votes', 0) == 0
                      // Lo stato del controllo lo puo' scrivere solo cosi': in
                      // attesa, o ammessa quando il controllo automatico non e'
                      // acceso. **Rifiutata non la si puo' scrivere da qui**, e
                      // soprattutto non si puo' scavalcare il controllo — a
                      // spostare una foto oltre "in attesa" e' il server, che
                      // con l'SDK di amministrazione non passa da queste regole.
                      && request.resource.data.get('moderation', 'approved')
                         in ['pending', 'approved']
                      // La vittoria non si porta da casa: la scrive il server.
                      && !('isWinner' in request.resource.data)
                      // La didascalia: facoltativa, corta, e scritta una volta
                      // sola. Si legge con `get` perche' le app gia' installate
                      // non la mandano, e una condizione che i telefoni vecchi
                      // non sanno soddisfare fa rifiutare le loro foto con un
                      // "non hai accesso" incomprensibile.
                      && request.resource.data.get('caption', '') is string
                      && request.resource.data.get('caption', '').size() <= 140
                      // IL GIORNO IN CUI I PAGAMENTI SI ACCENDONO, questa riga
                      // va tolta dal commento:
                      //
                      //   && challenge().get('prizeStatus', 'unpaid') == 'held'
                      //
                      // Impedisce di partecipare a una challenge il cui premio
                      // non e' stato incassato. Oggi rifiuterebbe **tutte** le
                      // partecipazioni — nessuna challenge e' mai stata pagata,
                      // perche' non esiste ancora niente che possa pagarla — e
                      // l'app smetterebbe di funzionare in silenzio.
                      //
                      // Sta scritta qui, e non in un appunto altrove, perche'
                      // e' qui che qualcuno la cerchera'.
                      && challengeIsLive();

        // **Una foto sola, e non si cambia.** L'autore non ha nessun permesso
        // di aggiornamento: non puo' sostituire la propria foto dopo aver visto
        // quante fiamme prende, che sarebbe cambiare la mano dopo aver guardato
        // le carte degli altri.

        // La fiamma: un campo solo, e di uno alla volta.
        //
        // Che il voto non venga messo due volte lo garantisce il documento
        // sotto `users/{uid}/votes`, che esiste o non esiste: qui si controlla
        // solo che il contatore non possa fare salti.
        //
        // Non c'e' nessun divieto di votarsi da soli: possono farlo tutti,
        // quindi non sposta la classifica: e' un voto in piu' per ciascuno.
        // A tenere onesta la gara e' il fatto che chi la lancia non partecipa.
        //
        // Il valore di partenza si legge con `get('votes', 0)` invece che
        // direttamente: le partecipazioni scritte prima che il campo esistesse
        // altrimenti resterebbero per sempre senza poter ricevere una fiamma.
        // La vittoria, scritta insieme alla proclamazione qui sopra. Stesse
        // due condizioni: gara finita, e nessun soldo in cassa.
        allow update: if signedIn()
                      && changedOnly(['isWinner'])
                      && request.resource.data.isWinner == true
                      && challenge().get('prizeStatus', 'unpaid') == 'unpaid'
                      && challenge().endsAt <= request.time;

        allow update: if signedIn()
                      && changedOnly(['votes'])
                      && (request.resource.data.votes
                            == resource.data.get('votes', 0) + 1
                          || request.resource.data.votes
                            == resource.data.get('votes', 0) - 1)
                      // **Allo scadere del tempo le fiamme si fermano.**
                      //
                      // E' la riga che rende vera la regola scritta nelle
                      // challenge: vince la foto con piu' voti **allo scadere
                      // del tempo**. Senza, un voto arrivato dopo la sirena
                      // sposterebbe dei soldi da una persona a un'altra, e
                      // l'app che lo impedisce sarebbe l'unica difesa — cioe'
                      // nessuna difesa, per chi scrive sul database
                      // direttamente.
                      //
                      // Costa una lettura in piu' per fiamma. Vale il prezzo:
                      // qui si sta decidendo chi incassa.
                      && challengeIsLive();

        // **Segnalare una foto: si aggiunge il proprio nome, e basta.**
        //
        // Il proprio, non quello di un altro, e **una volta sola**: la lista si
        // allunga esattamente di uno, e l'elemento nuovo e' chi sta scrivendo.
        // Senza queste due condizioni chiunque potrebbe riempire la lista di
        // nomi inventati e far sparire dalla gara la foto che sta vincendo, il
        // giorno prima che incassi il premio.
        //
        // Non si toglie: una segnalazione ritirata sotto minaccia e' peggio di
        // una segnalazione mai fatta. E l'autore non puo' segnalare se stesso.
        allow update: if signedIn()
                      && changedOnly(['reporters'])
                      && request.auth.uid != resource.data.userId
                      && request.resource.data.reporters.size()
                         == resource.data.get('reporters', []).size() + 1
                      && request.auth.uid in request.resource.data.reporters
                      && !(request.auth.uid in resource.data.get('reporters', []));

        // **Una foto in gara non si cancella. Una foto in una gara finita
        // si'.**
        //
        // Il divieto durante la gara non e' pignoleria: la partecipazione si
        // chiama come chi l'ha mandata — e' cosi' che vale la regola "una foto
        // a testa" — quindi cancellarla libererebbe il posto per mandarne
        // un'altra. Chi sta perdendo guarderebbe le fiamme degli altri, si
        // ritirerebbe e rientrerebbe con uno scatto migliore: cambiare la
        // propria carta dopo aver visto quelle degli avversari.
        //
        // A gara chiusa quel rischio non esiste piu' e resta solo il diritto di
        // portarsi via le proprie cose, che e' la strada su cui passa la
        // cancellazione dell'account.
        allow delete: if signedIn()
                      && request.auth.uid == entryId
                      && resource.data.userId == request.auth.uid
                      && !challengeIsLive();

        // I commenti sotto una foto.
        //
        // **Si scrivono solo mentre la gara e' aperta.** E' la stessa riga che
        // ferma le fiamme alla sirena, e per la stessa ragione: un commento e'
        // tifo, e il tifo si fa durante. Dopo, sotto la foto restano le fiamme
        // e basta — l'app smette di mostrarli, ed e' bene che smetta anche di
        // poterne accettare di nuovi.
        //
        // **Restano scritti anche quando spariscono dalla vista.** Cancellarli
        // davvero e' lavoro del server, che con l'SDK di amministrazione non
        // passa da qui: dare a un telefono il permesso di cancellare i commenti
        // altrui vorrebbe dire dare a chiunque il permesso di zittire chiunque.
        match /comments/{commentId} {
          allow read: if signedIn();

          allow create: if signedIn()
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.text is string
                        && request.resource.data.text.size() > 0
                        && request.resource.data.text.size() <= 300
                        // Il nome di chi scrive viaggia con il commento: senza,
                        // ogni riga costringerebbe a leggere anche il profilo
                        // di chi l'ha scritta.
                        && request.resource.data.authorName is string
                        && challengeIsLive();

          // **Un commento non si corregge.** Non e' rigore fine a se stesso: e'
          // che nessuno rilegge una conversazione gia' letta, e un commento
          // riscritto dopo che gli altri hanno risposto cambia il senso di
          // quello che hanno detto loro. Chi ha sbagliato cancella e riscrive.
          allow update: if false;

          // Il proprio si toglie, quello degli altri no.
          allow delete: if signedIn()
                        && resource.data.userId == request.auth.uid;
        }
      }
    }

    // **I guasti che l'app incontra da sola.**
    //
    // Ci si scrive e basta: nessuno li rilegge dall'app, si guardano dalla
    // console. Il permesso e' di sola scrittura anche per chi li scrive — un
    // elenco di errori leggibile da chiunque racconterebbe come e' fatta l'app
    // dentro, e a chi succedono.
    //
    // Solo chi ha fatto l'accesso, perche' un indirizzo aperto a chiunque
    // diventa un posto dove scaricare roba a spese nostre.
    match /crashes/{crashId} {
      allow read, update, delete: if false;

      allow create: if signedIn()
                    && request.resource.data.guasto is string
                    && request.resource.data.guasto.size() <= 500;
    }

  }
}

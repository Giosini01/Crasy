rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // dailies/{userId}/{dateKey}/{dailyId}.jpg
    match /dailies/{userId}/{dateKey}/{fileName} {
      // Come per Firestore, la lettura restera' da allargare quando il Per Te
      // mostrera' le Daily altrui.
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');

      // Una Daily pubblicata non si sovrascrive e non si cancella: e' il
      // patto con chi la guarda.
      allow update, delete: if false;
    }

    // profiles/{userId}/photo.jpg
    //
    // A differenza dell'Istantanea, questa si sovrascrive: la foto profilo e'
    // una sola e cambiarla e' normale.
    match /profiles/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

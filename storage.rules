rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Le foto delle partecipazioni: entries/{challengeId}/{userId}.jpg
    //
    // Il nome del file **e'** l'identificativo di chi lo carica: e' cio' che
    // impedisce di sovrascrivere la foto di un altro concorrente, ed e' anche
    // la stessa regola "una foto a testa" che vale su Firestore.
    match /entries/{challengeId}/{fileName} {
      // Pubbliche in lettura, come le challenge: si guardano anche senza aver
      // fatto l'accesso.
      allow read: if true;

      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if false;
    }

    // La foto profilo: profiles/{userId}/photo.jpg
    match /profiles/{userId}/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

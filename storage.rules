rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Le foto delle partecipazioni.
    //
    // Pubbliche in lettura, come le challenge: si guardano anche senza aver
    // fatto l'accesso. La regola copre **anche i percorsi vecchi**, quelli con
    // il file appeso direttamente alla challenge: le foto gia' in gara non
    // devono smettere di vedersi perche' e' cambiato lo schema.
    match /entries/{challengeId}/{allPaths=**} {
      allow read: if true;
    }

    // In scrittura: entries/{challengeId}/{userId}/{qualcosa}.jpg
    //
    // La cartella porta il nome di chi carica — e' cio' che impedisce di
    // toccare la foto di un altro concorrente — ma il **nome del file e'
    // casuale**, e questo e' il punto.
    //
    // Prima il file si chiamava come l'utente, ed era `create` soltanto: una
    // foto in gara non si sovrascrive. Solo che il caricamento avviene prima
    // della scrittura su Firestore, quindi un tentativo fallito a meta' lasciava
    // il file la' — e da quel momento **quella persona non poteva piu'
    // partecipare a quella challenge**, per sempre, con un "non hai accesso"
    // che non spiegava niente.
    //
    // Con un nome casuale ogni tentativo scrive un oggetto nuovo: i ritentativi
    // funzionano sempre, e ogni singolo oggetto resta immutabile come prima.
    match /entries/{challengeId}/{userId}/{fileName} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 12 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');

      allow update, delete: if false;
    }

    // La foto profilo: profiles/{userId}/photo.jpg
    match /profiles/{userId}/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
